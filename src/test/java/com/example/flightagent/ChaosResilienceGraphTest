package com.example.flightagent.langgraph4j;

import com.example.flightagent.domain.Booking;
import com.example.flightagent.domain.Flight;
import com.example.flightagent.tools.ChaosFlightTools;
import com.example.flightagent.tools.FlightReschedulingTools;
import org.bsc.langgraph4j.CompiledGraph;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Test;

import java.util.List;
import java.util.Map;
import java.util.function.Function;

import static org.junit.jupiter.api.Assertions.*;

class ChaosResilienceGraphTest {

    @Test
    @DisplayName("Self-heal: Graph retries search on transient timeout and completes rebooking")
    void testTransientFailure_RecoversAndCompletes() throws Exception {
        FlightReschedulingTools baseTools = new FlightReschedulingTools() {
            public Function<BookingRequest, Booking> getBookingStatus() {
                return req -> new Booking(req.bookingId(), "Jane Doe", "AC-100", 350.0);
            }
            public Function<FlightSearchRequest, List<Flight>> searchFlights() {
                return req -> List.of(new Flight("AC-101", "SEA", "2026-10-16 11:00", 450.0));
            }
            public Function<RebookRequest, String> rebookAndRefund() {
                return req -> "SUCCESS: Rebooked on AC-101";
            }
        };

        // Fail once, then succeed on retry #2
        ChaosFlightTools chaosTools = new ChaosFlightTools(baseTools, 1, false);

        LangGraphAgentConfig agentConfig = new LangGraphAgentConfig(chaosTools);
        CompiledGraph<FlightAgentState> graph = agentConfig.buildGraph().compile();

        Map<String, Object> input = Map.of(FlightAgentState.BOOKING_ID_KEY, "BKG-CHAOS-1");
        var finalStateOpt = graph.invoke(input);

        assertTrue(finalStateOpt.isPresent());
        FlightAgentState state = finalStateOpt.get();

        assertEquals(1, state.retryCount(), "Graph must log exactly one transient retry");
        assertEquals(450.0, state.selectedPrice());
        assertTrue(state.messages().contains("SUCCESS: Rebooked on AC-101"));
    }

    @Test
    @DisplayName("Circuit trip: Fallback to cached catalog when tool exhausts retries")
    void testPersistentFailure_TripsCircuitToCachedCatalog() throws Exception {
        FlightReschedulingTools baseTools = new FlightReschedulingTools() {
            public Function<BookingRequest, Booking> getBookingStatus() {
                return req -> new Booking(req.bookingId(), "John Doe", "AC-100", 350.0);
            }
            public Function<FlightSearchRequest, List<Flight>> searchFlights() {
                return req -> List.of(new Flight("AC-101", "SEA", "2026-10-16 11:00", 450.0));
            }
            public Function<RebookRequest, String> rebookAndRefund() {
                return req -> "REBOOKED";
            }
        };

        // Downstream tool is dead (fails 5 times)
        ChaosFlightTools chaosTools = new ChaosFlightTools(baseTools, 5, false);

        LangGraphAgentConfig agentConfig = new LangGraphAgentConfig(chaosTools);
        CompiledGraph<FlightAgentState> graph = agentConfig.buildGraph().compile();

        Map<String, Object> input = Map.of(FlightAgentState.BOOKING_ID_KEY, "BKG-CHAOS-2");
        var finalStateOpt = graph.invoke(input);

        assertTrue(finalStateOpt.isPresent());
        FlightAgentState state = finalStateOpt.get();

        assertEquals(2, state.retryCount(), "Graph must cap retries at threshold 2");
        assertTrue(state.messages().stream().anyMatch(m -> m.contains("CIRCUIT_BREAKER_TRIPPED")));
    }
}
